    local ContainerLayout = Instance.new("UIListLayout")
    ContainerLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ContainerLayout.Padding = UDim.new(0, 8)
    ContainerLayout.Parent = TabContainer

    local ContainerPadding = Instance.new("UIPadding")
    ContainerPadding.PaddingLeft = UDim.new(0, 2)
    ContainerPadding.PaddingRight = UDim.new(0, 6)
    ContainerPadding.PaddingTop = UDim.new(0, 2)
    ContainerPadding.Parent = TabContainer

    if FirstTab then
        TabBtn.TextColor3 = Themes.Text
        TabBtn.BackgroundColor3 = Themes.Accent
        TabStroke.Color = Themes.Accent
        FirstTab = false
    end

    TabBtn.MouseButton1Click:Connect(function()
        for _, child in pairs(ContainerFolder:GetChildren()) do
            if child:IsA("ScrollingFrame") then child.Visible = false end
        end
        for _, btn in pairs(SideBar:GetChildren()) do
            if btn:IsA("TextButton") then
                btn.BackgroundColor3 = Themes.Section
                btn.TextColor3 = Themes.SubText
                if btn:FindFirstChild("UIStroke") then
                    btn.UIStroke.Color = Themes.Stroke
                end
            end
        end
        TabContainer.Visible = true
        TabBtn.BackgroundColor3 = Themes.Accent
        TabBtn.TextColor3 = Themes.Text
        TabStroke.Color = Themes.Accent
    end)

    return TabContainer
end

local function AddSlider(parent, text, min, max, default, callback)
    local SldFrame = Instance.new("Frame")
    SldFrame.Size = UDim2.new(1, -5, 0, 48)
    SldFrame.BackgroundColor3 = Themes.Section
    SldFrame.Parent = parent

    Instance.new("UICorner", SldFrame).CornerRadius = UDim.new(0, 6)

    local SldStroke = Instance.new("UIStroke")
    SldStroke.Color = Themes.Stroke
    SldStroke.ApplyStrokeMode = "Border"
    SldStroke.Parent = SldFrame

    local SldTitle = Instance.new("TextLabel")
    SldTitle.Text = "  " .. text
    SldTitle.Font = Enum.Font.GothamMedium
    SldTitle.TextSize = 12
    SldTitle.TextColor3 = Themes.Text
    SldTitle.Position = UDim2.new(0, 0, 0, 5)
    SldTitle.Size = UDim2.new(0.7, 0, 0, 15)
    SldTitle.TextXAlignment = Enum.TextXAlignment.Left
    SldTitle.BackgroundTransparency = 1
    SldTitle.Parent = SldFrame

    local SldVal = Instance.new("TextLabel")
    SldVal.Text = tostring(default or min)
    SldVal.Font = Enum.Font.GothamBold
    SldVal.TextSize = 11
    SldVal.TextColor3 = Themes.Accent
    SldVal.Position = UDim2.new(0.7, 0, 0, 5)
    SldVal.Size = UDim2.new(0.3, -10, 0, 15)
    SldVal.TextXAlignment = Enum.TextXAlignment.Right
    SldVal.BackgroundTransparency = 1
    SldVal.Parent = SldFrame

    local Bar = Instance.new("TextButton")
    Bar.Text = ""
    Bar.Size = UDim2.new(1, -20, 0, 6)
    Bar.Position = UDim2.new(0, 10, 0, 30)
    Bar.BackgroundColor3 = Themes.Background
    Bar.Parent = SldFrame
    Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Themes.Accent
    Fill.Parent = Bar
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

    local isDragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pos)
        
        TweenService:Create(Fill, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(pos, 0, 1, 0)}):Play()
        SldVal.Text = tostring(val)
        if callback then callback(val) end
    end

    Bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            update(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    return SldFrame
end

local function AddToggle(parent, text, default, callback)
    local TogFrame = Instance.new("TextButton")
    TogFrame.Size = UDim2.new(1, -5, 0, 32)
    TogFrame.BackgroundColor3 = Themes.Section
    TogFrame.Text = "  " .. text
    TogFrame.Font = Enum.Font.GothamMedium
    TogFrame.TextSize = 12
    TogFrame.TextColor3 = Themes.Text
    TogFrame.TextXAlignment = Enum.TextXAlignment.Left
    TogFrame.AutoButtonColor = false
    TogFrame.Parent = parent

    Instance.new("UICorner", TogFrame).CornerRadius = UDim.new(0, 6)
    
    local TogStroke = Instance.new("UIStroke")
    TogStroke.Color = Themes.Stroke
    TogStroke.ApplyStrokeMode = "Border"
    TogStroke.Parent = TogFrame

    local Switch = Instance.new("Frame")
    Switch.Size = UDim2.new(0, 34, 0, 18)
    Switch.Position = UDim2.new(1, -40, 0.5, -9)
    Switch.BackgroundColor3 = default and Themes.Accent or Themes.Background
    Switch.Parent = TogFrame
    Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

    local SwitchStroke = Instance.new("UIStroke")
    SwitchStroke.Color = Themes.Stroke
    SwitchStroke.Parent = Switch

    local Circle = Instance.new("Frame")
    Circle.Size = UDim2.new(0, 12, 0, 12)
    Circle.Position = default and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
    Circle.BackgroundColor3 = Themes.Text
    Circle.Parent = Switch
    Instance.new("UICorner", Circle).CornerRadius = UDim.new(1, 0)

    local state = default or false
    if callback then callback(state) end

    local function SetState(newState)
        state = newState
        TweenService:Create(Switch, TweenInfo.new(0.2), {BackgroundColor3 = state and Themes.Accent or Themes.Background}):Play()
        TweenService:Create(Circle, TweenInfo.new(0.2), {Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)}):Play()
        if callback then callback(state) end
    end

    TogFrame.MouseButton1Click:Connect(function()
        SetState(not state)
    end)

    return TogFrame, SetState
end

