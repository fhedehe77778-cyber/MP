    CmdInput.PlaceholderText = ".yu8 [الاسم] أو .kill [الاسم]"
    CmdInput.Text = ""
    CmdInput.Font = Enum.Font.GothamMedium
    CmdInput.TextSize = 12
    CmdInput.TextColor3 = Themes.Text
    CmdInput.PlaceholderColor3 = Themes.SubText
    CmdInput.Parent = AdminFrame
    Instance.new("UICorner", CmdInput).CornerRadius = UDim.new(0, 6)

    -- ميزة التكملة التلقائية لاسم اللاعب فور كتابة أول 3 أحرف
    CmdInput:GetPropertyChangedSignal("Text"):Connect(function()
        local currentText = CmdInput.Text
        local spacePos = currentText:find(" ")
        if spacePos then
            local prefixPart = currentText:sub(1, spacePos)
            local namePart = currentText:sub(spacePos + 1)
            if #namePart >= 3 then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and (p.Name:lower():sub(1, #namePart) == namePart:lower() or p.DisplayName:lower():sub(1, #namePart) == namePart:lower()) then
                        CmdInput.Text = prefixPart .. p.Name
                        CmdInput.CursorPosition = #CmdInput.Text + 1
                        break
                    end
                end
            end
        end
    end)

    -- زر EXEC للتنفيذ
    local ExecBtn = Instance.new("TextButton")
