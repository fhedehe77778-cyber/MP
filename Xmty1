    local function getPlayerRole(player)
        if not player.Character then return "Innocent" end
        local backpack = player:FindFirstChild("Backpack")
        local char = player.Character
        
        local function hasTool(container, nameKeyword)
            if not container then return false end
            for _, item in pairs(container:GetChildren()) do
                if item:IsA("Tool") and string.find(item.Name:lower(), nameKeyword) then
                    return true
                end
            end
            return false
        end

        if hasTool(char, "knife") or hasTool(backpack, "knife") then
            return "Murderer"
        elseif hasTool(char, "gun") or hasTool(backpack, "gun") or hasTool(char, "revolver") or hasTool(backpack, "revolver") then
            return "Sheriff"
        else
            return "Innocent"
        end
    end

