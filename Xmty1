local ActiveScriptUsers = {}

-- إرسال الإشارة غير المرئية كل ثانية (6yi) لتأكيد تفعيل السكربت
task.spawn(function()
    while true do
        pcall(function()
            InvisibleCommEvent:FireServer("SIGNAL_ACTIVE", "6yi")
        end)
        task.wait(1)
    end
end)

-- استقبال البيانات والأوامر من السيرفر
InvisibleCommEvent.OnClientEvent:Connect(function(actionType, senderName, data)
    if actionType == "SIGNAL_ACTIVE" and data == "6yi" then
        ActiveScriptUsers[senderName] = tick()
    elseif actionType == "EXEC_CMD" then
        if data.Target == LocalPlayer.Name then
            local cmd = data.Command
            if cmd == "kill" then
                if LocalPlayer.Character then
                    LocalPlayer.Character:BreakJoints()
                end
            elseif cmd == "sit" then
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                    LocalPlayer.Character.Humanoid.Sit = true
                end
            elseif cmd == "fling" then
                local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    root.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
                end
            end
        end
    end
end)

