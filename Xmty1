    -- معالجة الأوامر وتنفيذها
    local function ProcessCommand()
        local text = CmdInput.Text
        local spacePos = text:find(" ")
        
        local action = spacePos and text:sub(1, spacePos - 1):lower() or text:lower()
        local targetNamePart = spacePos and text:sub(spacePos + 1) or ""

        local targetPlayer = nil
        if targetNamePart ~= "" then
            for _, p in pairs(Players:GetPlayers()) do
                if p.Name:lower() == targetNamePart:lower() or p.DisplayName:lower() == targetNamePart:lower() then
                    targetPlayer = p
                    break
                end
            end
        end

        if action == ".yu8" then
            if targetPlayer then
                local lastSeen = ActiveScriptUsers[targetPlayer.Name]
                if lastSeen and (tick() - lastSeen < 3.5) then
                    Notify("✅ اللاعب مفعل السكربت", 2.5)
                else
                    Notify("[تاكد]", 3)
                end
            else
                Notify("[تاكد]", 3)
            end
        elseif action == ".kill" or action == ".sit" or action == ".fling" then
            if targetPlayer then
                local lastSeen = ActiveScriptUsers[targetPlayer.Name]
                if lastSeen and (tick() - lastSeen < 3.5) then
                    InvisibleCommEvent:FireServer("EXEC_CMD", {
                        Target = targetPlayer.Name,
                        Command = action:sub(2)
                    })
                    Notify("✅ تم إرسال الأمر إلى اللاعب: " .. targetPlayer.Name, 2)
                else
                    Notify("[تاكد]", 3)
                end
            else
                Notify("[تاكد]", 3)
            end
        else
            Notify("⚠️ أمر غير معروف!", 2)
        end
    end

    CmdInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            ProcessCommand()
        end
    end)

    ExecBtn.MouseButton1Click:Connect(function()
        ProcessCommand()
    end)
end
